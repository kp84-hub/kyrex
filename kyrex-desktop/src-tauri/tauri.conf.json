{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kyrex Chat",
  "version": "0.1.4",
  "identifier": "dev.kyrex.chat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "launcher", "title": "Kyrex", "width": 84, "height": 84, "resizable": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "shadow": false, "visible": false },
      { "label": "settings", "title": "Kyrex companion", "width": 480, "height": 700, "minWidth": 420, "minHeight": 550, "url": "index.html", "visible": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1421; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["companion-controls"]
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["kyrex-chat"] } } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Kyrex Chat, one click away",
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false } }
  }
}
