FROM python:3.11-slim
RUN groupadd --gid 10001 jev && useradd --uid 10001 --gid 10001 --no-create-home jev \
    && pip install --no-cache-dir requests==2.32.5
WORKDIR /app
COPY automation/jev_router.py /app/jev_router.py
COPY kyrex_engine/kyrex/decision.py /app/kyrex/decision.py
RUN touch /app/kyrex/__init__.py
USER 10001:10001
CMD ["python", "-u", "/app/jev_router.py"]
