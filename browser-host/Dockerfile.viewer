# browser-host/Dockerfile.viewer — the MANUAL VIEWER image (Phase 3).
#
# A deliberately SEPARATE image from the headless Phase-1/Phase-2 one: this
# one carries the X/VNC/noVNC stack, so the default Chromium image stays
# small and keeps NO viewer surface. Build context is the repo root:
#
#   docker compose -f browser-host/docker-compose.viewer.yml build viewer
#
# Pinned dependencies
# -------------------
#   * pip: websockify==0.13.0 + its numpy==1.26.4 dependency — EXACT pins.
#   * apt (Debian 13 "trixie", only these, --no-install-recommends): chromium,
#     chromium-sandbox, xvfb, x11vnc, novnc, tini — the base's own locked set.
#     The pinned base digest resolves to Debian 13/trixie packages (NOT
#     bookworm), so trixie's own package versions apply.
#   * chromium-sandbox is installed EXPLICITLY and on purpose: the `chromium`
#     package only RECOMMENDS it, so --no-install-recommends would omit the
#     setuid sandbox helper. It is kept as a build-validated defense-in-depth
#     fallback, but it is NOT the sandbox this viewer uses. The viewer
#     deliberately passes --disable-setuid-sandbox (viewer_ctl.py) so Chromium
#     runs its USER-NAMESPACE sandbox; the actual blocker for that path was
#     Docker's builtin seccomp (NOT AppArmor), and it is fixed by the
#     repository-managed profile bound to the viewer service only
#     (browser-host/seccomp/kyrex-viewer-chromium.json). AppArmor stays
#     docker-default (enforcing) and needs no profile; there is no added
#     capability, no privileged mode, no host-wide kernel change, and no
#     sandbox-disabling flag.
#   * base image: `python:3.11-slim` DIGEST-PINNED to the OCI image index
#     sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
#     (as of 2026-09-01). Re-verify ONLY when intentionally bumping:
#     `docker buildx imagetools inspect python:3.11-slim`.
#
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        chromium-sandbox \
        xvfb \
        x11vnc \
        novnc \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Build-time GATE on the RETAINED sandbox helper. `chromium-sandbox` must be
# present with the exact ownership and setuid mode Chromium's Zygote expects
# when a setuid sandbox is used: root:root, mode 4755 (setuid root). The viewer
# does not take that path, but the helper is kept as a defense-in-depth
# fallback and validated here so it can never silently rot; a missing or
# wrongly-moded helper therefore FAILS THE BUILD at image-build time, not on
# the VPS.
RUN set -eux; \
    sandbox=/usr/lib/chromium/chrome-sandbox; \
    test -f "$sandbox"; \
    test -x "$sandbox"; \
    test -u "$sandbox"; \
    test "$(stat -c '%U:%G' "$sandbox")" = "root:root"; \
    test "$(stat -c '%a' "$sandbox")" = "4755"

# X11 expects /tmp/.X11-unix to exist, owned by root with the sticky
# world-writable mode (1777) so ANY user can create its own display socket in
# it. The non-root viewer cannot create the directory itself — Xvfb fails with
# "_XSERVTransmkdir: ERROR: euid != 0, directory /tmp/.X11-unix will not be
# created" — so pre-create AND verify it here, while we are still root.
RUN set -eux; \
    mkdir -p /tmp/.X11-unix; \
    chown root:root /tmp/.X11-unix; \
    chmod 1777 /tmp/.X11-unix; \
    test "$(stat -c '%U:%G' /tmp/.X11-unix)" = "root:root"; \
    test "$(stat -c '%a' /tmp/.X11-unix)" = "1777"

# Exact pip pins (no-range, no-latest): the only programmatic dependency is
# websockify, which is the noVNC websocket gateway; numpy is its one dep.
RUN pip install --no-cache-dir websockify==0.13.0 numpy==1.26.4

# Non-root viewer user (uid 1000, matching the host's owner user that owns
# ./profiles subdirectories so Chromium can open the persistent profile).
RUN useradd -u 1000 -ms /bin/bash viewer

WORKDIR /host
COPY browser-host/viewer_ctl.py /host/viewer_ctl.py
COPY browser-host/manual_mode.py /host/manual_mode.py
COPY browser-host/profiles.py /host/profiles.py
RUN chmod 0755 /host/*.py && chown -R viewer:viewer /host

# Chromium must be able to write temp/dev flags in these standard spots.
ENV HOME=/home/viewer \
    KYREX_BROWSER_PROFILES_ROOT=/profiles

USER viewer

ENTRYPOINT ["tini", "--", "python3", "/host/viewer_ctl.py", "hold"]
